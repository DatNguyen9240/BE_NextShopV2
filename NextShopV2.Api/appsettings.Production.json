{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Error"
    }
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "${SMTP_USER}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_USER}",
    "FromName": "${SMTP_FROM_NAME}"
  }
}