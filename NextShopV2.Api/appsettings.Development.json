{
  "ConnectionStrings": {
    "DefaultConnection": "Server=${DB_HOST};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;",
    "Redis": "${REDIS_CONNECTION}"
  },
  "PayOS": {
    "ClientId": "${PAYOS_CLIENT_ID}",
    "ApiKey": "${PAYOS_API_KEY}",
    "ChecksumKey": "${PAYOS_CHECKSUM_KEY}"
  },
  "Frontend": {
    "BaseUrl": "${FRONTEND_URL}"
  }
}