{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "NextShopAPI",
    "Audience": "NextShopUsers"
  },
  "Firebase": {
    "ServiceAccountKeyPath": "Config/serviceAccountKey.json"
  },
  "Resend": {
    "ApiKey": "${RESEND_API_KEY}",
    "FromEmail": "${RESEND_FROM_EMAIL}",
    "FromName": "${RESEND_FROM_NAME}"
  }
}