{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "${JWT_KEY}",
    "Issuer": "NextShopAPI",
    "Audience": "NextShopUsers"
  },
  "Cloudinary": {
    "CloudName": "${CLOUDINARY_NAME}",
    "ApiKey": "${CLOUDINARY_KEY}",
    "ApiSecret": "${CLOUDINARY_SECRET}"
  },
  "Firebase": {
    "ServiceAccountKeyPath": "Config/serviceAccountKey.json"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "Username": "${SMTP_USER}",
    "Password": "${SMTP_PASSWORD}",
    "FromEmail": "${SMTP_USER}",
    "FromName": "${SMTP_FROM_NAME}"
  }
}

