# Development Environment Template
# Copy this to .env.development and fill in your values

DB_HOST=localhost\SQLEXPRESS03
DB_NAME=NextShopDB
DB_USER=sa
DB_PASSWORD=your_dev_password
REDIS_CONNECTION=localhost:6379,AbortOnConnectFail=false

JWT_KEY=your_jwt_secret_key_dev
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

PAYOS_CLIENT_ID=your_payos_client_id_dev
PAYOS_API_KEY=your_payos_api_key_dev
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_dev

RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=NextShop

FRONTEND_URL=http://localhost:3000
FIREBASE_SERVICE_ACCOUNT_JSON={ "type": "service_account", ... }
